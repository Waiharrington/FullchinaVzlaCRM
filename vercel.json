{
  "crons": [
    {
      "path": "/api/daily-sales-email",
      "schedule": "0 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/pedir",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/optimized/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/videos/instagram/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(pedir|pedir.html|index.html|sw.js|manifest-cliente.webmanifest|manifest-admin.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pedir",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "(?i).*(whatsapp|facebook|twitter|slack|discord|telegram|linkedin|pinterest|skypeuripreview|vkshare|redditbot|line|applebot|googlebot|bingbot|yandexbot|duckduckbot).*"
          }
        }
      ],
      "destination": "/api/pedir-seo"
    },
    {
      "source": "/pedir/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "(?i).*(whatsapp|facebook|twitter|slack|discord|telegram|linkedin|pinterest|skypeuripreview|vkshare|redditbot|line|applebot|googlebot|bingbot|yandexbot|duckduckbot).*"
          }
        }
      ],
      "destination": "/api/pedir-seo"
    },
    {
      "source": "/pedir",
      "destination": "/pedir.html"
    },
    {
      "source": "/pedir/",
      "destination": "/pedir.html"
    },
    {
      "source": "/sitemap-images.xml",
      "destination": "/api/pedir-seo?format=images"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
