SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_SESSION_PATH=./.wwebjs_auth
WHATSAPP_QR_PORT=3033
# Genera el token con: openssl rand -hex 32
# Se exigen >= 32 caracteres aleatorios; si es débil (ej. "change-me"),
# el servidor QR queda deshabilitado y el bot avisa al arrancar.
WHATSAPP_QR_ACCESS_TOKEN=
# 127.0.0.1 = solo accesible por túnel SSH (recomendado).
# Usa 0.0.0.0 únicamente detrás de un proxy con HTTPS.
WHATSAPP_QR_HOST=127.0.0.1
WHATSAPP_QUEUE_AUTOMATIONS=false
# La cola de envío está APAGADA por defecto: solo envía si es "true" exacto.
WHATSAPP_SEND_QUEUE=false
# El bot NO responde mensajes entrantes por defecto (solo envía campañas).
WHATSAPP_AUTO_REPLY=false
